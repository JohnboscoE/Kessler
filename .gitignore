node_modules/
dist/
.env
.env.local

# HydraDB local store — regenerated by the loader, never committed
.hydradb/

# Ingest artefacts.
# data/raw/ is the packument cache: large, reproducible from the registry,
# and explicitly re-fetchable. data/out/ is derived JSONL.
data/raw/
data/out/
# Guard against a stray map written when a process runs from a subdirectory.
**/data/out/

# The fixture's lockfile is committed on purpose — it is the bundled example,
# generated by npm and not hand-written. Its install tree is not.
fixtures/**/node_modules/

# Source footage is 11MB and is not needed to build or run the app;
# public/kessler-field.mp4 is the baked 2.5MB asset that ships.
assets/

.DS_Store
Thumbs.db
*.log
